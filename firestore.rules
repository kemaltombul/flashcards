rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // YARDIMCI FONKSİYONLAR
    // ═══════════════════════════════════════════════════════════════

    function isLoggedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    function collectionData(collectionId) {
      return get(/databases/$(database)/documents/collections/$(collectionId)).data;
    }

    function isCollectionOwner(collectionId) {
      return isLoggedIn() &&
        collectionData(collectionId).owner_id == request.auth.uid;
    }

    function isCollectionEditor(collectionId) {
      return isLoggedIn() &&
        request.auth.uid in collectionData(collectionId).editor_uids;
    }

    function isCollectionMember(collectionId) {
      return isCollectionOwner(collectionId) || isCollectionEditor(collectionId);
    }


    // ═══════════════════════════════════════════════════════════════
    // 1. KULLANICI PROFİLLERİ  /users/{userId}
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {

      allow read: if isLoggedIn();

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll(['uid', 'username'])
        && request.resource.data.uid    == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3;

      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if false;

      match /word_stats/{wordId} {
        allow read:   if isSelf(userId);

        allow create: if isSelf(userId)
          && request.resource.data.keys().hasAll(['collection_id', 'view_count'])
          && request.resource.data.collection_id is string
          && request.resource.data.view_count    is int;

        allow update: if isSelf(userId);
        allow delete: if isSelf(userId);
      }
    }


    // ═══════════════════════════════════════════════════════════════
    // 2. KOLEKSİYONLAR  /collections/{collectionId}
    // ═══════════════════════════════════════════════════════════════
    match /collections/{collectionId} {

      allow read: if isLoggedIn() && (
        resource.data.owner_id == request.auth.uid           ||
        request.auth.uid in resource.data.editor_uids        ||
        resource.data.is_shared == true
      );

      allow create: if isLoggedIn()
        && request.resource.data.keys().hasAll([
             'name', 'owner_id', 'is_shared', 'editor_uids', 'share_code', 'created_at'
           ])
        && request.resource.data.owner_id   == request.auth.uid
        && request.resource.data.name        is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.is_shared   is bool
        && request.resource.data.editor_uids is list;

      allow update: if isLoggedIn()
        && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == resource.data.owner_id;

      allow update: if isLoggedIn()
        && request.auth.uid in resource.data.editor_uids
        && request.resource.data.owner_id    == resource.data.owner_id
        && request.resource.data.editor_uids == resource.data.editor_uids;

      allow delete: if isLoggedIn()
        && resource.data.owner_id == request.auth.uid;
    }


    // ═══════════════════════════════════════════════════════════════
    // 3. KELİMELER  /words/{wordId}
    // ═══════════════════════════════════════════════════════════════
    match /words/{wordId} {

      allow read: if isLoggedIn();

      allow create: if isLoggedIn()
        && request.resource.data.keys().hasAll(['collection_id', 'word', 'definition'])
        && request.resource.data.collection_id is string
        && request.resource.data.collection_id.size() > 0
        && request.resource.data.word           is string
        && request.resource.data.word.size()    >= 1
        && isCollectionMember(request.resource.data.collection_id);

      allow update: if isLoggedIn()
        && isCollectionMember(resource.data.collection_id)
        && request.resource.data.collection_id == resource.data.collection_id;

      allow delete: if isLoggedIn()
        && isCollectionMember(resource.data.collection_id);
    }


    // ═══════════════════════════════════════════════════════════════
    // 4. APP LOGS  /app_logs/{logId}
    // ═══════════════════════════════════════════════════════════════
    match /app_logs/{logId} {
      // Tüm authenticated kullanıcılar log yazabilir
      allow write: if isLoggedIn();
      // Sadece admin okuyabilir
      allow read: if request.auth.uid == 'CQk9Sf8MK4VwyBkQNjYK3ZdlzL13';
    }

  }
}
